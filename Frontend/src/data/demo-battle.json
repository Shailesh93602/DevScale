      "id": "q2",
      "question": "Which array method returns a NEW array without mutating the original?",
      "options": ["push", "splice", "sort", "map"],
      "correct_answer": 3,
      "explanation": "map builds a new array from the callback's return values; push, splice and sort all mutate in place.",
      "points": 100,
      "time_limit": 30
    },
    {
      "id": "q3",
      "question": "What is logged? `console.log(0.1 + 0.2 === 0.3)`",
      "options": ["true", "false", "NaN", "TypeError"],
      "correct_answer": 1,
      "explanation": "Binary floating point cannot represent 0.1 or 0.2 exactly; the sum is 0.30000000000000004.",
      "points": 100,
      "time_limit": 30
    },
    {
      "id": "q4",
      "question": "Which statement about `const` is correct?",
      "options": [
        "The value it holds can never change",
        "The binding cannot be reassigned, but an object it points to can be mutated",
        "It is hoisted and initialised to undefined",
        "It is function-scoped"
      ],
      "correct_answer": 1,
      "explanation": "const freezes the binding, not the value. Object.freeze is what makes an object immutable.",
      "points": 100,
      "time_limit": 30
    },
    {
      "id": "q5",
      "question": "What does `Promise.allSettled` resolve with when one promise rejects?",
      "options": [
        "It rejects with the first error",
        "An array of {status, value|reason} for every promise",
        "Only the fulfilled values",
        "undefined"
      ],
      "correct_answer": 1,
      "explanation": "Unlike Promise.all, allSettled never short-circuits; it reports each outcome.",
      "points": 100,
      "time_limit": 30
    }
